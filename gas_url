    // --- APP LOGIC CORE ---
    function initApp() {
        terapkanIdentitasKeUI();
        const saved = localStorage.getItem('cahayaExplorerDataIslami');
        if (saved) { state = JSON.parse(saved); ensureStateIntegrity(); showScreen('screen-dashboard'); }
        renderSidebarNav(); updateUI();
    }
    
    function ensureStateIntegrity() {
        if(!state.labSelesaiArr) state.labSelesaiArr = [];
        if(!state.detektifSelesaiArr) state.detektifSelesaiArr = [];
        if(!state.jurnalData || state.jurnalData.length !== 3) state.jurnalData = ["","",""];
        if(!state.refleksiData) state.refleksiData = ["","","","",""];
    }

    function simpanProgres() { 
        localStorage.setItem('cahayaExplorerDataIslami', JSON.stringify(state)); 
        simpanKeRuangGuru(); updateUI(); 
    }

    function simpanKeRuangGuru() {
        if(!state.nama) return;
        let allUsers = JSON.parse(localStorage.getItem('cahayaSemuaSiswa') || '[]');
        let idx = allUsers.findIndex(u => u.nama === state.nama && u.kelas === state.kelas);
        if(idx > -1) allUsers[idx] = state; else allUsers.push(state);
        localStorage.setItem('cahayaSemuaSiswa', JSON.stringify(allUsers));
    }
    
