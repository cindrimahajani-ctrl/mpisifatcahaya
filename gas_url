    function updateUI() {
        if(!state.nama) {
            document.getElementById('ui-stars').innerText = "0";
            document.getElementById('ui-score').innerText = "0";
            return;
        }
        document.getElementById('ui-stars').innerText = state.bintang;
        document.getElementById('ui-score').innerText = state.skor;
        
        let cDash = document.getElementById('dash-skor'); if(cDash) cDash.innerText = state.skor;
        let cMisi = document.getElementById('dash-misi'); if(cMisi) cMisi.innerText = state.misiSelesai.length;
        let cBint = document.getElementById('dash-bintang'); if(cBint) cBint.innerText = state.bintang;
        
        const btnCert = document.getElementById('btn-lihat-sertifikat');
        // Kriteria Sertifikat: Semua misi teori, semua praktik lab, semua misi detektif, dan sudah kuis minimal 1 kali.
        const isEligible = state.misiSelesai.length === 5 && state.labSelesaiArr.length === 5 && state.detektifSelesaiArr.length === 5 && state.kuisHistory.length > 0;
        
        if(btnCert) btnCert.style.display = isEligible ? "inline-flex" : "none";

        const certNama = document.getElementById('cert-nama'); if(certNama) certNama.innerText = escapeHTML(state.nama);
        const certKelas = document.getElementById('cert-kelas'); if(certKelas) certKelas.innerText = escapeHTML(state.kelas);
        const certTanggal = document.getElementById('cert-tanggal'); 
        if(certTanggal) {
            let tgl = new Date().toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });
            if(state.kuisHistory.length > 0) tgl = state.kuisHistory[state.kuisHistory.length-1].tgl;
            certTanggal.innerText = tgl;
        }

        let predikatCert = "SANGAT BAIK";
        if(state.kuisHistory.length > 0) {
            let lastScore = state.kuisHistory[state.kuisHistory.length-1].skor;
            if(lastScore < 60) predikatCert = "PERLU BIMBINGAN";
            else if(lastScore < 76) predikatCert = "CUKUP";
            else if(lastScore < 86) predikatCert = "BAIK";
        }
        document.getElementById('cert-predikat').innerText = predikatCert;
        
        cekLencana();
    }
    
    function cekLencana() {
        const b = document.getElementById('badge-container'); if(!b) return; b.innerHTML = "";
        const bdg = [
            { id:'b1', icon:'🧐', title:'Pengamat Hebat', desc:'Membuka misi pertama', kriteria: state.misiUnlocked >= 1 },
            { id:'b2', icon:'🧪', title:'Ilmuwan Cilik', desc:'Menyelesaikan eksperimen', kriteria: state.labSelesaiArr.length > 0 },
            { id:'b3', icon:'🕵️‍♂️', title:'Detektif Cahaya', desc:'Misi detektif sempurna', kriteria: state.detektifSelesaiArr.length === 5 },
            { id:'b4', icon:'🔬', title:'Ahli Eksperimen', desc:'Selesai semua LAB', kriteria: state.labSelesaiArr.length === 5 },
            { id:'b5', icon:'❤️', title:'Penjelajah Karakter', desc:'Selesai Panca Cinta', kriteria: state.refleksiSelesai }
        ];
        bdg.forEach(x => {
            b.innerHTML += `<div class="badge-item ${x.kriteria?'earned':''}" title="${x.desc}">
                <div class="badge-icon">${x.icon}</div><div class="badge-title">${x.title}</div>
            </div>`;
        });
    }

    function showScreen(id) {
        document.querySelectorAll('.screen').forEach(el => el.classList.remove('active'));
        document.getElementById(id).classList.add('active');
        document.getElementById('main-header').style.display = (id === 'screen-welcome' || id === 'screen-certificate') ? 'none' : 'flex';
        
        if(id === 'screen-welcome' || id === 'screen-map' || id === 'screen-dashboard') startBGM('adventure');
        else if(id === 'screen-mission-detail') startBGM('lab');
        else if(id === 'screen-quiz' || id === 'screen-hots') startBGM('quiz');
        
        if (id === 'screen-map') renderMap();
        if (id === 'screen-dashboard') updateUI();
        if (id === 'screen-galeri') renderGaleri();
        if (id === 'screen-jurnal') loadJurnal();
        if (id === 'screen-hots' && hotsIdx===0) mulaiHots();
        if (id === 'screen-guru') renderTabelGuru();
        renderSidebarNav();
    }
    
    function showInputModal() { 
        playClick(); initAudio(); 
        if (state.nama !== "") showScreen('screen-map'); else document.getElementById('modal-login').style.display = 'flex'; 
    }
    
    function mulaiAplikasi() {
        playClick(); 
        const n = document.getElementById('input-nama').value.trim(); 
        const k = document.getElementById('input-kelas').value;
        if (n === "" || k === "") { tampilkanPesan("Nama dan Kelas wajib diisi ya, Detektif!"); return; }
        
        let allUsers = JSON.parse(localStorage.getItem('cahayaSemuaSiswa') || '[]');
        let existingUser = allUsers.find(u => u.nama.toLowerCase() === n.toLowerCase() && u.kelas === k);
        
        if(existingUser) {
            state = JSON.parse(JSON.stringify(existingUser));
            ensureStateIntegrity();
            tampilkanPesan(`Selamat datang kembali, ${state.nama}! Progresmu berhasil dimuat.`);
        } else {
            state = { 
                nama: n, kelas: k, skor: 0, bintang: 0, misiUnlocked: 1, 
                misiSelesai: [], kuisHistory: [], refleksiSelesai: false, renunganMisi: {},
                labSelesaiArr: [], detektifSelesaiArr: [], hotsSelesai: 0, 
                jurnalData: ["","",""], refleksiData: ["","","","",""]
            };
        }
        
        // PANGGIL FUNGSI KIRIM DATA SOAL SAAT PERTAMA KALI LOGIN
        kirimDataSoalKeGAS();

        document.getElementById('modal-login').style.display = 'none';
        simpanProgres(); 
        showScreen('screen-map');
    }

    function renderMap() {
        const c = document.getElementById('mission-container'); c.innerHTML = "";
        missions.forEach(m => {
            const isUnl = m.id <= state.misiUnlocked; const isCom = state.misiSelesai.includes(m.id);
            let cls = isCom ? "completed" : (isUnl ? "unlocked" : "locked");
            let div = document.createElement('div'); div.className = `mission-card ${cls}`;
            div.innerHTML = `<div style="font-size:40px;">${m.icon}</div><div style="font-weight:bold;margin:10px 0;">Misi ${m.id}</div><div style="font-size:0.8rem;color:#777;">${m.title}</div>`;
            if (isUnl) div.onclick = () => { playClick(); bukaMisi(m.id); };
            c.appendChild(div);
        });
    }

