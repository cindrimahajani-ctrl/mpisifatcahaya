            showMascot("Luar biasa insting detektifmu!", "anim-jump");
            
            if(!state.detektifSelesaiArr.includes(id)) state.detektifSelesaiArr.push(id);
            if(!state.misiSelesai.includes(id)) {
                state.misiSelesai.push(id); state.skor += 20; state.bintang += 10;
                if(state.misiUnlocked < 5 && state.misiUnlocked === id) state.misiUnlocked++;
