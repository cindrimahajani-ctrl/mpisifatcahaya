    let audioCtx; let bgmOsc = null, bgmGain = null; let isBGMOn = true, isSFXOn = true; let currentTheme = 'adventure'; 
    function initAudio() { if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }
    function playTone(freq, type, duration, vol=0.1) {
        if(!isSFXOn) return; initAudio(); const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
        osc.type = type; osc.frequency.setValueAtTime(freq, audioCtx.currentTime); gain.gain.setValueAtTime(vol, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + duration); osc.connect(gain); gain.connect(audioCtx.destination);
        osc.start(); osc.stop(audioCtx.currentTime + duration);
    }
    function playClick() { playTone(600, 'sine', 0.1, 0.05); }
    function playSuccess() { playTone(800, 'triangle', 0.1); setTimeout(()=>playTone(1200, 'triangle', 0.2), 100); }
    function playWrong() { playTone(200, 'sawtooth', 0.3); }
    function playSparkle() { [800, 1000, 1200, 1500].forEach((f, i) => setTimeout(() => playTone(f, 'sine', 0.1, 0.05), i*100)); }
    function playFanfare() { playTone(400, 'square', 0.2); setTimeout(()=>playTone(500, 'square', 0.2), 200); setTimeout(()=>playTone(600, 'square', 0.4), 400); setTimeout(()=>playTone(800, 'square', 0.6), 800); }
    function startBGM(theme) {
        if(!isBGMOn) return; initAudio(); stopBGM(); currentTheme = theme; bgmOsc = audioCtx.createOscillator(); bgmGain = audioCtx.createGain();
        let freq = 200, type = 'sine';
        if(theme === 'adventure') { freq = 261.63; type = 'triangle'; } else if(theme === 'lab') { freq = 196.00; type = 'sine'; } else if(theme === 'quiz') { freq = 329.63; type = 'square'; } 
        bgmOsc.type = type; bgmOsc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        const lfo = audioCtx.createOscillator(); lfo.frequency.value = 0.5; const lfoGain = audioCtx.createGain(); lfoGain.gain.value = 10;
        lfo.connect(lfoGain); lfoGain.connect(bgmOsc.frequency); lfo.start();
        bgmGain.gain.value = 0.02; bgmOsc.connect(bgmGain); bgmGain.connect(audioCtx.destination); bgmOsc.start();
    }
    function stopBGM() { if(bgmOsc) { bgmOsc.stop(); bgmOsc.disconnect(); bgmOsc = null; } }
    function toggleBGM() { isBGMOn = !isBGMOn; document.getElementById('btn-bgm').innerText = isBGMOn ? "🎵 BGM: ON" : "🎵 BGM: OFF"; if(isBGMOn) startBGM(currentTheme); else stopBGM(); playClick(); }
