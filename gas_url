        // Islami & Fenomena
        document.getElementById('fenomena-isi').innerHTML = m.fenomena.isi; document.getElementById('fenomena-aktivitas').innerHTML = m.fenomena.aktivitas;
        document.getElementById('quran-arab').innerText = m.quran.arab; document.getElementById('quran-surah').innerText = m.quran.surah;
        document.getElementById('quran-arti').innerText = m.quran.arti; document.getElementById('quran-pesan').innerText = m.quran.pesan;
        document.getElementById('refleksi-cinta').innerText = m.cinta; document.getElementById('refleksi-tanya').innerText = m.refleksi;
        document.getElementById('refleksi-jawaban').value = state.renunganMisi[id] || "";

        // Lab (Prediksi)
        labSelesaiState = state.labSelesaiArr.includes(id); 
        document.getElementById('lab-judul').innerText = m.lab.judul; document.getElementById('lab-instruksi').innerText = m.lab.instruksi;
        document.getElementById('lab-alat').innerText = m.lab.alat; document.getElementById('prediksi-1').innerText = m.lab.prediksi1; 
        document.getElementById('prediksi-2').innerText = m.lab.prediksi2; document.getElementById('lab-prediksi').value = "";
        document.getElementById('lab-kesimpulan-teks').style.display = 'none';
        document.getElementById('lab-area').innerHTML = m.lab.html;
        if(m.lab.js) { let s = document.createElement('script'); s.text = m.lab.js; document.body.appendChild(s); }
        
        // Game (Misi Detektif)
        document.getElementById('game-ilustrasi').innerText = m.game.ilustrasi;
        document.getElementById('game-tanya').innerText = m.game.tanya;
        let gO = document.getElementById('game-opsi'); gO.innerHTML = "";
        document.getElementById('game-feedback-container').style.display = "none";
        
        m.game.opsi.forEach(op => {
            let b = document.createElement('button'); b.className = "btn"; b.innerText = op.teks; b.style.background="white"; b.style.flex="1"; b.style.minWidth="100%";
            b.onclick = () => cekGameDetektif(b, op.benar, m, id); gO.appendChild(b);
        });
        
        document.getElementById('tab-btn-game').style.opacity = labSelesaiState ? '1' : '0.5';
        document.getElementById('tab-btn-game').style.cursor = labSelesaiState ? 'pointer' : 'not-allowed';

