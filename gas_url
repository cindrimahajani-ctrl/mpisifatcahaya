    function kirimDataKeGAS(payload) {
        if (GAS_URL === "URL_GAS_ANDA_DISINI" || GAS_URL === "") {
            console.warn("GAS URL belum disetting. Data tidak dikirim ke Google Sheets.");
            return;
        }
        
        fetch(GAS_URL, {
            method: 'POST',
            // Kita gunakan text/plain untuk menghindari issue preflight CORS di browser
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify(payload)
        })
        .then(response => response.json())
        .then(result => console.log("Sukses kirim ke GAS:", result))
        .catch(error => console.error("Error kirim ke GAS:", error));
    }

