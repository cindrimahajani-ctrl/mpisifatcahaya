    function mulaiKuis() { 
        kAktif = [...quizBank].sort(() => 0.5 - Math.random()).slice(0, 5); 
        kIdx = 0; 
        kSkor = 0; 
        // Reset Tracker
        kuisBenarCount = 0;
        kuisSalahCount = 0;
        detailJawabanKuis = [];
        showScreen('screen-quiz'); 
        renderKuis(); 
