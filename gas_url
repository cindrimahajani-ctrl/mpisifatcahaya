                window.hitungSnellius = function() {
                    let t1 = parseInt(document.getElementById('slide-sudut').value);
                    let n1 = 1.00; // udara
                    let n2 = 1.33; // air
                    
                    let rad1 = t1 * (Math.PI / 180);
                    let sin_t2 = (n1 / n2) * Math.sin(rad1);
                    let rad2 = Math.asin(sin_t2);
                    let t2 = rad2 * (180 / Math.PI);
                    
                    document.getElementById('val-sudut-datang').innerText = t1 + '°';
                    document.getElementById('val-sudut-bias').innerText = t2.toFixed(1) + '°';
                    
                    let svgW = document.getElementById('svg-snell').clientWidth || 300;
                    let cx = svgW / 2;
                    let cy = 100; // batas medium
                    
                    // Sinar datang
                    let x1 = cx - (100 * Math.tan(rad1));
                    document.getElementById('sinar-datang').setAttribute('x1', x1);
                    document.getElementById('sinar-datang').setAttribute('x2', cx);
                    
                    // Panah datang
                    let midXd = (x1 + cx) / 2; let midYd = 50;
                    document.getElementById('panah-datang').setAttribute('transform', \`translate(\${midXd-5}, \${midYd-5}) rotate(\${90-t1})\`);
                    
                    // Sinar bias
                    let x2 = cx + (100 * Math.tan(rad2));
                    document.getElementById('sinar-bias').setAttribute('x1', cx);
                    document.getElementById('sinar-bias').setAttribute('x2', x2);
                    
                    // Panah bias
                    let midXb = (cx + x2) / 2; let midYb = 150;
