    function buatLaporanIndividual(u) {
        let mS = u.misiSelesai ? u.misiSelesai.length : 0;
        let lS = u.labSelesaiArr ? u.labSelesaiArr.length : 0;
        let dS = u.detektifSelesaiArr ? u.detektifSelesaiArr.length : 0;
        let hS = u.hotsSelesai || 0;
        
        let nilaiAkhir = 0; let tglKuis = "-";
        if(u.kuisHistory && u.kuisHistory.length > 0) {
            let last = u.kuisHistory[u.kuisHistory.length-1];
            nilaiAkhir = last.skor; tglKuis = last.tgl;
        }
        
        let predikat = "Belum Kuis";
        if(nilaiAkhir > 0) {
            if(nilaiAkhir < 60) predikat = "Memerlukan Bimbingan";
            else if(nilaiAkhir < 76) predikat = "Cukup";
            else if(nilaiAkhir < 86) predikat = "Baik";
            else predikat = "Sangat Baik";
        }

        let jd = u.jurnalData || ["","",""];
        let statusJurnal = (jd[0].trim()!=="" || jd[1].trim()!=="") ? "Sudah diisi" : "Belum diisi";
        let tglAktivitas = tglKuis !== "-" ? tglKuis : new Date().toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });

        // Rekomendasi
        let rek = `<ul>`;
        if(mS < 5) rek += `<li>Perlu menyelesaikan sisa ${5 - mS} misi materi teori.</li>`;
        if(lS < 5) rek += `<li>Perlu menyelesaikan sisa ${5 - lS} eksperimen laboratorium.</li>`;
        if(hS < 3) rek += `<li>Latihan kembali soal-soal HOTS untuk meningkatkan penalaran analitis.</li>`;
        if(nilaiAkhir > 0 && nilaiAkhir < 76) rek += `<li>Pelajari kembali rangkuman materi sebelum mengulang evaluasi akhir.</li>`;
        if(mS===5 && lS===5 && hS>=4 && nilaiAkhir>=86) rek = `<ul><li>Sangat baik! Pertahankan prestasimu dan lanjutkan eksplorasi sains tingkat lanjut.</li></ul>`;
        else rek += `</ul>`;

        // JSON stringify and URI encode for passing object in onclick safely
        let userPayload = encodeURIComponent(JSON.stringify(u));

        return `
        <div style="background:white; border:2px solid var(--primary-blue); border-radius:10px; padding:20px; box-shadow:0 4px 10px rgba(0,0,0,0.1); text-align:left;">
            <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:2px solid #eee; padding-bottom:15px; margin-bottom:15px;">
                <div style="display:flex; align-items:center; gap:15px;">
                    <img src="${pengaturanGuru.logo}" alt="Logo" style="height:50px; object-fit:contain;" onerror="this.src='https://placehold.co/50x50/ffffff/000000?text=Logo'">
                    <div>
                        <h3 style="margin:0; color:var(--dark-blue); font-size:1.2rem;">Laporan Individual: ${escapeHTML(u.nama)}</h3>
                        <div style="color:#777; font-size:0.9rem;">Kelas: ${escapeHTML(u.kelas)} | Aktivitas Terakhir: ${tglAktivitas}</div>
                    </div>
                </div>
                <div>
                    <button class="btn btn-success" style="font-size:0.8rem; padding:8px 12px;" onclick="unduhLaporanPDF(JSON.parse(decodeURIComponent('${userPayload}')))">📥 Unduh Laporan PDF</button>
                </div>
            </div>
            
            <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(250px, 1fr)); gap:20px;">
                <div style="background:#e8f4f8; padding:15px; border-radius:8px; border-left:4px solid var(--primary-blue);">
                    <h4 style="margin-bottom:10px; color:var(--primary-blue);">B. Pemahaman Materi</h4>
                    <div>Materi Diselesaikan: <strong>${mS} / 5</strong></div>
                    <div>Belum Diselesaikan: <strong>${5 - mS}</strong></div>
                    <div style="margin-top:5px; font-weight:bold;">Status: <span style="color:${mS===5?'green':'red'};">${mS === 5 ? 'Tuntas' : 'Belum Tuntas'}</span></div>
                </div>
                
                <div style="background:#fdf5e6; padding:15px; border-radius:8px; border-left:4px solid var(--orange);">
                    <h4 style="margin-bottom:10px; color:var(--orange);">C. Praktik Laboratorium</h4>
                    <div>Eksperimen Diselesaikan: <strong>${lS} / 5</strong></div>
                    <div>Belum Diselesaikan: <strong>${5 - lS}</strong></div>
                    <div style="margin-top:5px; font-weight:bold;">Status: <span style="color:${lS===5?'green':'red'};">${lS === 5 ? 'Tuntas' : 'Belum Tuntas'}</span></div>
                </div>

                <div style="background:#eef6eb; padding:15px; border-radius:8px; border-left:4px solid var(--nature-green);">
                    <h4 style="margin-bottom:10px; color:var(--nature-green);">D. Misi Detektif & HOTS</h4>
                    <div>Misi Detektif Selesai: <strong>${dS} / 5</strong></div>
                    <div>Skor Tantangan HOTS: <strong>${hS} / 5</strong></div>
                    <div style="margin-top:5px; font-weight:bold;">Status: <span style="color:${(dS===5 && hS>=3)?'green':'red'};">${(dS===5 && hS>=3) ? 'Tuntas' : 'Belum Tuntas'}</span></div>
                </div>

                <div style="background:#f4f1fa; padding:15px; border-radius:8px; border-left:4px solid #8e44ad;">
                    <h4 style="margin-bottom:10px; color:#8e44ad;">E. Jurnal Penjelajah</h4>
                    <div>Status Jurnal: <strong>${statusJurnal}</strong></div>
                    ${statusJurnal === 'Sudah diisi' ? `<div style="font-size:0.85rem; color:#555; margin-top:5px; max-height:60px; overflow-y:auto; font-style:italic;">"${escapeHTML(jd[0])}"</div>` : ''}
                </div>

                <div style="background:#fff3cd; padding:15px; border-radius:8px; border-left:4px solid var(--bright-yellow);">
                    <h4 style="margin-bottom:10px; color:#d35400;">F. Evaluasi Akhir</h4>
                    <div>Nilai Kuis: <strong>${nilaiAkhir}</strong></div>
                    <div>Tanggal Kuis: <strong>${tglKuis}</strong></div>
                    <div style="margin-top:5px; font-weight:bold;">Predikat: <span style="color:var(--orange);">${predikat}</span></div>
                </div>

                <div style="background:#f9f9f9; padding:15px; border-radius:8px; border-left:4px solid #7f8c8d;">
                    <h4 style="margin-bottom:10px; color:#34495e;">G. Rekomendasi Guru</h4>
                    <div style="font-size:0.9rem; margin-left:-20px;">${rek}</div>
                </div>
            </div>
            
            <div style="text-align:center; margin-top:20px;">
                <button class="btn" style="background:#ddd; font-size:0.9rem;" onclick="this.closest('tr').style.display='none'">Tutup Detail</button>
            </div>
        </div>
        `;
    }

    function filterTabelGuru() {
        let inputStr = document.getElementById('rg-cari').value.toLowerCase();
        let selKelas = document.getElementById('rg-filter-kelas').value;
        let rows = document.querySelectorAll('.row-guru');
        
        rows.forEach(r => {
            let nama = r.querySelector('.t-nama').innerText.toLowerCase();
            let kelas = r.querySelector('.t-kelas').innerText;
            let idDetail = r.getAttribute('data-target');
            let trDetail = document.getElementById(idDetail);
            
            let mNama = nama.includes(inputStr);
            let mKelas = (selKelas === "" || kelas === selKelas);
            
            if(mNama && mKelas) {
                r.style.display = "";
                if(trDetail) trDetail.style.display = "none";
            } else {
                r.style.display = "none";
                if(trDetail) trDetail.style.display = "none";
            }
        });
    }

    function eksporCSV() {
        let allUsers = JSON.parse(localStorage.getItem('cahayaSemuaSiswa') || '[]');
        let csvContent = "data:text/csv;charset=utf-8,Nama,Kelas,Skor XP,Misi Materi Selesai,Laboratorium Selesai,HOTS Selesai,Nilai Kuis Terakhir\n";
        allUsers.forEach(u => {
            let nK = (u.kuisHistory && u.kuisHistory.length > 0) ? u.kuisHistory[u.kuisHistory.length-1].skor : 0;
            let mS = u.misiSelesai ? u.misiSelesai.length : 0;
            let lS = u.labSelesaiArr ? u.labSelesaiArr.length : 0;
            let hS = u.hotsSelesai || 0;
            csvContent += `"${u.nama}","${u.kelas}",${u.skor || 0},${mS},${lS},${hS},${nK}\n`;
        });
        var encodedUri = encodeURI(csvContent);
        var link = document.createElement("a"); link.setAttribute("href", encodedUri); link.setAttribute("download", "Rekap_Nilai_Cahaya_Explorer.csv");
        document.body.appendChild(link); link.click(); link.remove();
    }
    
    // LOGOUT, HAPUS, & RESET
    function logoutMurid() {
        playClick();
        if(confirm("Apakah kamu yakin ingin keluar dari akunmu? (Tenang, progresmu akan tetap tersimpan)")) {
            simpanKeRuangGuru();
            localStorage.removeItem('cahayaExplorerDataIslami');
            state = { 
                nama: "", kelas: "", skor: 0, bintang: 0, misiUnlocked: 1, 
                misiSelesai: [], kuisHistory: [], refleksiSelesai: false, renunganMisi: {},
                labSelesaiArr: [], detektifSelesaiArr: [], hotsSelesai: 0, 
                jurnalData: ["","",""], refleksiData: ["","","","",""]
            };
            document.getElementById('input-nama').value = "";
            document.getElementById('input-kelas').value = "";
            showScreen('screen-welcome');
            updateUI();
        }
    }

    function hapusAkunMurid(nama, kelas) {
        if(confirm(`Yakin ingin menghapus data murid ${nama} (${kelas}) secara permanen? Penghapusan ini tidak memengaruhi murid lain.`)) {
            let allUsers = JSON.parse(localStorage.getItem('cahayaSemuaSiswa') || '[]');
            allUsers = allUsers.filter(u => !(u.nama === nama && u.kelas === kelas));
            localStorage.setItem('cahayaSemuaSiswa', JSON.stringify(allUsers));
            
            // Jika yang dihapus sedang login
            if(state.nama === nama && state.kelas === kelas) {
                localStorage.removeItem('cahayaExplorerDataIslami');
                state = { nama: "", kelas: "", skor: 0, bintang: 0, misiUnlocked: 1, misiSelesai: [], kuisHistory: [], refleksiSelesai: false, renunganMisi: {}, labSelesaiArr: [], detektifSelesaiArr: [], hotsSelesai: 0, jurnalData: ["","",""], refleksiData: ["","","","",""] };
            }
            renderTabelGuru();
        }
    }

    function resetSemuaSiswaData() {
        playClick();
        let konfirmasi = prompt("PERINGATAN: Menghapus data ini akan menghilangkan progres SELURUH siswa.\nKetik 'HAPUS' untuk melanjutkan:");
        if(konfirmasi === 'HAPUS') {
            localStorage.removeItem('cahayaSemuaSiswa'); 
            localStorage.removeItem('cahayaExplorerDataIslami'); 
            location.reload();
        } else if(konfirmasi !== null) {
            tampilkanPesan("Penghapusan dibatalkan.");
        }
    }

    // --- CETAK PDF LAPORAN ---
    function unduhLaporanPDF(u) {
        if (typeof html2pdf === 'undefined') { tampilkanPesan("Fitur PDF tidak dimuat. Periksa koneksi internet."); return; }
        playClick();
        
        let mS = u.misiSelesai ? u.misiSelesai.length : 0;
        let lS = u.labSelesaiArr ? u.labSelesaiArr.length : 0;
        let dS = u.detektifSelesaiArr ? u.detektifSelesaiArr.length : 0;
        let hS = u.hotsSelesai || 0;
        
        let nilaiAkhir = 0; let tglKuis = "-";
        if(u.kuisHistory && u.kuisHistory.length > 0) {
            let last = u.kuisHistory[u.kuisHistory.length-1];
            nilaiAkhir = last.skor; tglKuis = last.tgl;
        }
        
        let predikat = "Belum Ada Nilai", saranKuis = "Belum mengikuti kuis akhir.";
        if(nilaiAkhir > 0) {
            if(nilaiAkhir < 60) { predikat = "Memerlukan Bimbingan"; saranKuis = "Murid disarankan mengulang kembali seluruh materi dan mengikuti evaluasi kembali.";}
            else if(nilaiAkhir < 76) { predikat = "Cukup"; saranKuis = "Murid perlu melakukan pendalaman pada beberapa konsep yang masih keliru sebelum melanjutkan."; }
            else if(nilaiAkhir < 86) { predikat = "Baik"; saranKuis = "Hasil belajar baik. Pertahankan semangat untuk terus mengeksplorasi ilmu sains."; }
            else { predikat = "Sangat Baik"; saranKuis = "Hasil yang luar biasa. Murid dapat melanjutkan ke tahap pengayaan materi sains tingkat lanjut."; }
        }

        let jd = u.jurnalData || ["","",""];
        let statusJurnal = (jd[0].trim()!=="" || jd[1].trim()!=="") ? "Sudah diisi" : "Belum diisi";
        
        // Analisis Perkembangan Belajar
        let narasi1 = `Murid telah mengikuti pembelajaran sifat-sifat cahaya melalui kegiatan memahami konsep, melakukan eksperimen interaktif, menyelesaikan tantangan penerapan, dan mengikuti evaluasi akhir. `;
        let narasi2 = `Berdasarkan catatan aktivitas pembelajaran, murid telah menyelesaikan <strong>${mS} dari 5</strong> misi materi teori dan <strong>${lS} dari 5</strong> eksperimen laboratorium. `;
        let narasi3 = `Pada bagian penerapan konsep (HOTS), murid menyelesaikan tantangan dengan skor <strong>${hS} dari 5</strong>. `;
        let narasi4 = nilaiAkhir > 0 ? `Pada evaluasi akhir, murid memperoleh nilai <strong>${nilaiAkhir}</strong> dengan predikat <strong>${predikat}</strong>.` : `Murid belum menyelesaikan evaluasi kuis akhir.`;
        
        // Rekomendasi tambahan
        let rek = `<ul>`;
        if(mS < 5) rek += `<li>Murid belum menyelesaikan seluruh misi teori. Disarankan untuk melengkapi kembali literasi bacaan pada peta misi.</li>`;
        if(lS < 5) rek += `<li>Masih ada eksperimen laboratorium yang terlewat. Murid disarankan melakukan pembuktian praktikum untuk memperkuat konsep visual.</li>`;
        if(hS < 3) rek += `<li>Kemampuan penalaran (HOTS) masih perlu dilatih. Murid perlu sering diberikan permasalahan sehari-hari untuk dianalisis.</li>`;
        rek += `<li>${saranKuis}</li></ul>`;
        if(mS===5 && lS===5 && hS>=4 && nilaiAkhir>=86) rek = `<ul><li>Tercapai hasil yang sangat optimal pada seluruh tahap. Lanjutkan belajar mandiri dengan melakukan pengamatan cahaya nyata di alam sekitar.</li></ul>`;

        let c = document.getElementById('pdf-template-container');
        c.style.display = 'block';
        c.innerHTML = `
            <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:3px solid var(--primary-blue); padding-bottom:15px; margin-bottom:20px;">
                <img src="${pengaturanGuru.logo}" alt="Logo" style="height:70px;" onerror="this.src='https://placehold.co/70x70/ffffff/000000?text=Logo'">
                <div style="text-align:right;">
                    <h2 style="margin:0; color:var(--primary-blue); font-size:18px;">LAPORAN PERKEMBANGAN HASIL BELAJAR</h2>
                    <div style="font-weight:bold; color:var(--orange);">Media Interaktif CAHAYA EXPLORER</div>
                </div>
            </div>
            
            <h3 style="background:#e8f4f8; padding:8px; margin-bottom:10px; font-size:14px; border-left:5px solid var(--primary-blue);">BAGIAN A. IDENTITAS MURID</h3>
            <table style="width:100%; font-size:13px; margin-bottom:20px;">
                <tr><td style="width:150px; font-weight:bold;">Nama Murid</td><td style="width:10px;">:</td><td>${escapeHTML(u.nama)}</td></tr>
                <tr><td style="font-weight:bold;">Kelas</td><td>:</td><td>${escapeHTML(u.kelas)}</td></tr>
                <tr><td style="font-weight:bold;">Nama Sekolah</td><td>:</td><td>${escapeHTML(pengaturanGuru.sekolah)}</td></tr>
                <tr><td style="font-weight:bold;">Materi / Jenjang</td><td>:</td><td>Sifat-Sifat Cahaya / Kelas V SD/MI</td></tr>
            </table>

            <h3 style="background:#e8f4f8; padding:8px; margin-bottom:10px; font-size:14px; border-left:5px solid var(--primary-blue);">BAGIAN B. DESKRIPSI ALUR PEMBELAJARAN</h3>
            <div style="font-size:12px; line-height:1.5; margin-bottom:20px;">
                <p><strong>TAHAP 1. MEMAHAMI KONSEP</strong><br>Murid mempelajari materi dengan mengamati ilustrasi dan mengenali fenomena cahaya kehidupan sehari-hari. <em>(Terselesaikan: ${mS} dari 5 Misi)</em></p>
                <p><strong>TAHAP 2. MELAKUKAN PRAKTIK & EKSPERIMEN</strong><br>Murid melaksanakan kegiatan mengamati, membuat prediksi, dan menjalankan simulasi pembuktian pada laboratorium fisika. <em>(Terselesaikan: ${lS} dari 5 Eksperimen)</em></p>
                <p><strong>TAHAP 3. MENERAPKAN DAN MENGANALISIS</strong><br>Murid memecahkan tantangan Misi Detektif dan soal Berpikir Kritis (HOTS) untuk menerapkan konsep secara logis. <em>(Misi Detektif: ${dS}/5, Nilai HOTS: ${hS}/5)</em></p>
                <p><strong>TAHAP 4. REFLEKSI PEMBELAJARAN</strong><br>Murid melakukan refleksi pengetahuan pada Jurnal Penjelajah. <em>(Status: ${statusJurnal})</em><br>
                ${statusJurnal === 'Sudah diisi' ? `- Hal baru: <em>"${escapeHTML(jd[0])}"</em><br>- Paling menarik: <em>"${escapeHTML(jd[1])}"</em>` : ''}</p>
                <p><strong>TAHAP 5. EVALUASI AKHIR</strong><br>Pengukuran penguasaan materi melalui Kuis interaktif akhir. <em>(Nilai Kuis: ${nilaiAkhir})</em></p>
            </div>

            <h3 style="background:#e8f4f8; padding:8px; margin-bottom:10px; font-size:14px; border-left:5px solid var(--primary-blue);">BAGIAN C. REKAPITULASI HASIL BELAJAR</h3>
            <table border="1" style="width:100%; border-collapse:collapse; font-size:12px; text-align:center; margin-bottom:20px;">
                <tr style="background:#f1f2f6; font-weight:bold;">
                    <td style="padding:5px;">Aspek Pembelajaran</td><td style="padding:5px;">Indikator Target</td><td style="padding:5px;">Hasil Murid</td>
                </tr>
                <tr><td style="padding:5px;">Pemahaman Konsep</td><td style="padding:5px;">5 Misi Materi Selesai</td><td style="padding:5px;">${mS} Misi Selesai</td></tr>
                <tr><td style="padding:5px;">Praktik Lab</td><td style="padding:5px;">5 Eksperimen Selesai</td><td style="padding:5px;">${lS} Eksperimen Selesai</td></tr>
                <tr><td style="padding:5px;">Penerapan</td><td style="padding:5px;">5 Misi Detektif Selesai</td><td style="padding:5px;">${dS} Detektif Selesai</td></tr>
                <tr><td style="padding:5px;">Penalaran</td><td style="padding:5px;">Tantangan HOTS (Skor 5)</td><td style="padding:5px;">Skor ${hS}</td></tr>
                <tr><td style="padding:5px;">Refleksi</td><td style="padding:5px;">Jurnal Penjelajah Terisi</td><td style="padding:5px;">${statusJurnal}</td></tr>
                <tr style="font-weight:bold; background:#e8f4f8;"><td style="padding:5px;">Evaluasi Akhir</td><td style="padding:5px;">Nilai Kuis Akhir</td><td style="padding:5px;">Nilai: ${nilaiAkhir} (${predikat})</td></tr>
            </table>

            <h3 style="background:#e8f4f8; padding:8px; margin-bottom:10px; font-size:14px; border-left:5px solid var(--primary-blue);">BAGIAN D. ANALISIS PERKEMBANGAN BELAJAR</h3>
            <p style="font-size:12px; line-height:1.5; margin-bottom:20px; text-align:justify;">${narasi1}${narasi2}${narasi3}${narasi4}</p>

            <h3 style="background:#e8f4f8; padding:8px; margin-bottom:10px; font-size:14px; border-left:5px solid var(--primary-blue);">BAGIAN E. REKOMENDASI TINDAK LANJUT</h3>
            <div style="font-size:12px; line-height:1.5; margin-bottom:30px;">${rek}</div>

            <div style="display:flex; justify-content:space-between; font-size:12px; padding:0 30px; margin-top:40px;">
                <div style="text-align:left; color:#777;"><br><br><br>Dokumen digenerasi oleh sistem CAHAYA EXPLORER.</div>
                <div style="text-align:center;">
                    <p>Mengesahkan,<br>Guru Kelas V - ${escapeHTML(pengaturanGuru.sekolah)}</p>
                    <div style="height:60px;"></div>
                    <p style="font-weight:bold; text-decoration:underline;">${escapeHTML(pengaturanGuru.guru)}</p>
                    <p style="margin-top:5px;">Tanggal Laporan: ${new Date().toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
                </div>
            </div>
        `;

        const opt = { margin: [10, 10], filename: `Laporan_Hasil_Belajar_${escapeHTML(u.nama)}_${escapeHTML(u.kelas)}.pdf`, html2canvas: { scale: 2 }, jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' } };
        html2pdf().set(opt).from(c).save().then(() => {
            setTimeout(() => { c.style.display = 'none'; }, 1000);
        });
    }

    window.onload = () => { initApp(); };
</script>
</body>
</html>
