    function renderKuis() {
        if(kIdx >= kAktif.length) { selesaiKuis(); return; }
        const s = kAktif[kIdx]; document.getElementById('quiz-current-num').innerText = kIdx+1; document.getElementById('quiz-progress').style.width = `${(kIdx/kAktif.length)*100}%`;
        document.getElementById('quiz-question').innerText = s.q;
        let og = document.getElementById('quiz-options'); og.innerHTML = ""; document.getElementById('quiz-feedback').style.display="none"; document.getElementById('btn-next-quiz').style.display="none";
        let options = s.o.map((opt, i) => ({text: opt, isCorrect: i === s.a})).sort(() => 0.5 - Math.random());
        options.forEach((ops) => {
            let b = document.createElement('button'); b.className = "btn"; b.style.background="white"; b.innerText = ops.text; b.onclick = () => pilihKuis(b, ops.isCorrect, og, options); og.appendChild(b);
        });
    }

    function pilihKuis(btn, benar, grid, optionsData) {
        if(btn.disabled) return; 
        Array.from(grid.childNodes).forEach(b => b.disabled = true);
        
        // Perekaman Data Jawaban untuk Spreadsheet
        let soalTeks = kAktif[kIdx].q;
        let jawabanSiswaTeks = btn.innerText;
        detailJawabanKuis.push({
            soal: soalTeks,
            jawaban: jawabanSiswaTeks,
            status: benar ? "BENAR" : "SALAH"
        });
        
        let fb = document.getElementById('quiz-feedback'); fb.style.display="block";
        if(benar) { 
            playSuccess(); btn.style.background = "#d4edda"; fb.innerText="✅ Tepat Sekali!"; 
            kSkor += (100 / kAktif.length); 
            kuisBenarCount++;
            showMascot("Pintar!", "anim-jump", 1500); 
        } 
        else { 
            playWrong(); btn.style.background = "#f8d7da"; fb.innerText="❌ Jawaban kurang tepat."; 
            kuisSalahCount++;
            showMascot("Yah, salah deh.", "anim-shake", 1500); 
            Array.from(grid.childNodes).forEach((c, idx) => { if(optionsData[idx].isCorrect) c.style.background = "#d4edda"; }); 
        }
        document.getElementById('btn-next-quiz').style.display="inline-block";
    }

