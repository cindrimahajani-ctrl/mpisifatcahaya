<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CAHAYA EXPLORER - Misi Detektif Cahaya (Edisi Kurikulum Cinta)</title>
    <!-- Library html2pdf.js untuk mengunduh Laporan PDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        /* === VARIABEL WARNA & TEMA === */
        :root {
            --primary-blue: #0088cc;
            --sky-blue: #74b9ff;
            --dark-blue: #0984e3;
            --nature-green: #00b894;
            --bright-yellow: #fdcb6e;
            --orange: #e17055;
            --white: #ffffff;
            --text-dark: #2d3436;
            --bg-light: #f1f2f6;
            --btn-shadow: rgba(0, 0, 0, 0.2);
            --gold-islamic: #d4af37;
        }

        /* === RESET & GLOBAL STYLES === */
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; user-select: none; }
        body { background-color: var(--sky-blue); background-image: radial-gradient(circle, #a2d1ff 0%, #74b9ff 100%); color: var(--text-dark); overflow-x: hidden; display: flex; justify-content: center; align-items: center; min-height: 100vh; }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-thumb { background: var(--dark-blue); border-radius: 10px; }

        #app-container { width: 100%; max-width: 1024px; height: 100vh; max-height: 768px; background-color: var(--bg-light); position: relative; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.3); border: 4px solid var(--white); border-radius: 20px; display: flex; flex-direction: column; }

        /* === TYPOGRAPHY & BUTTONS === */
        h1, h2, h3 { color: var(--dark-blue); font-weight: 800; text-align: center; margin-bottom: 15px;}
        .btn { background-color: var(--bright-yellow); color: var(--text-dark); border: none; padding: 12px 24px; font-size: 1.1rem; font-weight: bold; border-radius: 30px; cursor: pointer; box-shadow: 0 6px 0 #e6a83a, 0 8px 10px var(--btn-shadow); transition: all 0.1s; display: inline-flex; align-items: center; justify-content: center; gap: 10px; text-decoration: none;}
        .btn:active { transform: translateY(6px); box-shadow: 0 0px 0 #e6a83a, 0 2px 5px var(--btn-shadow); }
        .btn-primary { background-color: var(--primary-blue); color: white; box-shadow: 0 6px 0 #005f8f; }
        .btn-success { background-color: var(--nature-green); color: white; box-shadow: 0 6px 0 #008f73; }
        .btn-danger { background-color: var(--orange); color: white; box-shadow: 0 6px 0 #b75a43; }
        .btn-info { background-color: #8e44ad; color: white; box-shadow: 0 6px 0 #732d91; }
        .btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none !important; box-shadow: none !important; }

        /* === LAYOUT SCREENS === */
        .screen { display: none; width: 100%; height: 100%; flex-direction: column; position: absolute; top: 0; left: 0; background: white; animation: fadeIn 0.4s ease-out; }
        .screen.active { display: flex; }
        @keyframes fadeIn { from { opacity: 0; transform: scale(0.98); } to { opacity: 1; transform: scale(1); } }

        .header-bar { background: var(--primary-blue); color: white; padding: 10px 20px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 10px rgba(0,0,0,0.1); z-index: 10; }
        .header-title { display: flex; align-items: center; gap: 10px; font-weight: bold; font-size: 1.2rem; }
        .header-stats { display: flex; gap: 15px; font-weight: bold; background: rgba(0,0,0,0.2); padding: 5px 15px; border-radius: 20px; align-items: center;}
        
        .audio-controls { display: flex; gap: 10px; }
        .btn-audio { background: rgba(255,255,255,0.2); border: none; color: white; padding: 5px 10px; border-radius: 15px; cursor: pointer; font-size: 0.9rem; transition: 0.2s; }
        .btn-audio:hover { background: rgba(255,255,255,0.4); }

        .content-area { flex: 1; padding: 20px; overflow-y: auto; position: relative; background: linear-gradient(135deg, #e0f7fa 0%, #ffffff 100%); }

        /* === PANELS CSS === */
        .panel-islami { background: linear-gradient(135deg, #0a3d62 0%, #0984e3 100%); color: white; border: 4px solid var(--gold-islamic); border-radius: 15px; padding: 25px; margin-top: 20px; position: relative; overflow: hidden; box-shadow: 0 8px 20px rgba(0,0,0,0.15); }
        .panel-islami::before { content: ""; position: absolute; top:0; left:0; width:100%; height:100%; background-image: repeating-linear-gradient(45deg, rgba(212, 175, 55, 0.1) 0, rgba(212, 175, 55, 0.1) 2px, transparent 2px, transparent 10px); pointer-events: none; }
        .panel-islami h4 { color: var(--gold-islamic); font-size: 1.3rem; margin-bottom: 15px; text-transform: uppercase; letter-spacing: 1px; border-bottom: 2px solid var(--gold-islamic); padding-bottom: 5px; display:inline-block;}
        .arabic-text { font-size: 2rem; font-weight: bold; text-align: right; line-height: 2.2; margin: 15px 0; color: var(--gold-islamic); font-family: "Amiri", "Traditional Arabic", serif; text-shadow: 1px 1px 5px rgba(0,0,0,0.5);}
        .ayat-terjemah { font-style: italic; font-size: 1.05rem; margin-bottom: 15px; line-height: 1.6; opacity: 0.9;}
        .ayat-pesan { background: rgba(255,255,255,0.1); padding: 15px; border-radius: 10px; line-height: 1.5; font-size: 1rem; border-left: 5px solid var(--gold-islamic);}
        
        .panel-fenomena { background: #e8f4f8; border: 3px solid #74b9ff; border-left: 10px solid var(--primary-blue); padding: 20px; border-radius: 15px; margin-top: 20px; box-shadow: 0 4px 10px rgba(0,0,0,0.05); }
        .panel-fenomena h4 { color: var(--primary-blue); margin-bottom: 15px; display:flex; align-items:center; gap:8px; font-size:1.2rem;}
        .panel-fenomena ul { margin-left: 25px; line-height: 1.8; color: #34495e;}
        .panel-fenomena .aktivitas { background: white; padding: 15px; border-radius: 10px; margin-top: 15px; border: 1px dashed var(--primary-blue); font-weight: bold; color: var(--dark-blue);}

        .panel-refleksi { background: #fff9e6; border: 3px solid var(--bright-yellow); padding: 20px; border-radius: 15px; margin-top: 20px; text-align: left; position: relative; }
        .panel-refleksi h4 { color: #d35400; margin-bottom: 10px; display:flex; align-items:center; gap:8px;}
        .panel-refleksi p { font-size: 1.05rem; line-height: 1.5; color: #444; margin-bottom: 15px;}
        .panel-refleksi textarea, .textarea-custom { width: 100%; padding: 12px; border-radius: 10px; border: 2px solid #e1b12c; font-family: inherit; font-size:1rem; resize: vertical; outline:none; transition:0.3s;}
        .panel-refleksi textarea:focus, .textarea-custom:focus { border-color: var(--orange); box-shadow: 0 0 10px rgba(225, 112, 85, 0.3);}
        .panca-cinta { display:inline-block; background: var(--nature-green); color: white; padding: 5px 12px; border-radius: 20px; font-size: 0.9rem; font-weight: bold; margin-bottom: 10px;}

        /* === WELCOME SCREEN === */
        #screen-welcome { background: linear-gradient(to bottom, #74b9ff, #a2d1ff); justify-content: center; align-items: center; text-align: center; position: relative; overflow: hidden; }
        .cloud { position: absolute; background: white; border-radius: 50px; opacity: 0.8; animation: floatClouds linear infinite; }
        .cloud::before, .cloud::after { content: ''; position: absolute; background: white; border-radius: 50%; }
        @keyframes floatClouds { from { transform: translateX(-200px); } to { transform: translateX(1200px); } }

        .welcome-card { background: rgba(255, 255, 255, 0.95); padding: 30px; border-radius: 30px; box-shadow: 0 15px 30px rgba(0,0,0,0.2); border: 5px solid var(--primary-blue); max-width: 600px; position: relative; z-index: 2; }
        .app-title { font-size: 3.5rem; color: var(--primary-blue); text-shadow: 2px 2px 0px var(--bright-yellow); margin-bottom: 5px; line-height: 1.1; }
        
        /* === FLOATING PROFILE === */
        #floating-profile { position: absolute; top: 20px; left: 20px; z-index: 50; display: flex; align-items: center; gap: 12px; background: rgba(255,255,255,0.95); padding: 8px 12px; border-radius: 50px; box-shadow: 0 5px 15px rgba(0,0,0,0.15); border: 2px solid var(--sky-blue); cursor: pointer; transition: all 0.4s; }
        #floating-profile:hover { transform: translateY(-3px); border-color: var(--primary-blue); }
        .profile-avatar { position: relative; width: 45px; height: 45px; border-radius: 50%; overflow: hidden; border: 2px solid var(--bright-yellow); background-color: var(--primary-blue); display: flex; justify-content: center; align-items: center; color: white; font-weight: bold; flex-shrink: 0; }
        .profile-avatar img { width: 100%; height: 100%; object-fit: cover; position: relative; z-index: 2; }
        .profile-initials { position: absolute; z-index: 1; }
        .profile-details { overflow: hidden; white-space: nowrap; transition: max-width 0.4s ease, opacity 0.4s ease; max-width: 0; opacity: 0; text-align: left; }
        #floating-profile.expanded .profile-details { max-width: 250px; opacity: 1; margin-right: 10px; }
        .profile-school-logo { width: 0; opacity: 0; transition: all 0.4s ease; overflow: hidden; flex-shrink: 0; display: flex; border-radius: 50%; background: white;}
        #floating-profile.expanded .profile-school-logo { width: 45px; height: 45px; opacity: 1; margin-left: 5px; border: 2px solid var(--nature-green); }
        .profile-school-logo img { width: 100%; height: 100%; object-fit: contain; padding: 2px; }

        /* === MASCot === */
        #mascot-container { position: absolute; bottom: -150px; left: 20px; z-index: 50; transition: bottom 0.5s; display: flex; align-items: flex-end; gap: 15px; pointer-events: none; }
        #mascot-container.show { bottom: 20px; }
        .mascot-char { font-size: 80px; filter: drop-shadow(0 5px 5px rgba(0,0,0,0.2)); }
        .mascot-bubble { background: white; border: 3px solid var(--primary-blue); padding: 10px 20px; border-radius: 20px; border-bottom-left-radius: 0; font-weight: bold; color: var(--dark-blue); box-shadow: 0 5px 15px rgba(0,0,0,0.1); max-width: 200px; font-size: 1rem; }
        
        @keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-5px) rotate(-5deg); } 75% { transform: translateX(5px) rotate(5deg); } }
        @keyframes jump { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-20px); } }
        .anim-shake { animation: shake 0.4s ease-in-out; }
        .anim-jump { animation: jump 0.5s ease-in-out; }

        .confetti { position: absolute; width: 10px; height: 10px; background-color: #f00; z-index: 100; animation: fall 3s linear forwards; }
        @keyframes fall { to { transform: translateY(100vh) rotate(720deg); opacity: 0; } }

        /* === DASHBOARD, MAP, & SIDEBAR === */
        .dashboard-layout { display: flex; height: 100%; }
        .sidebar { width: 220px; background: var(--dark-blue); color: white; padding: 20px; display: flex; flex-direction: column; gap: 10px; overflow-y: auto;}
        .sidebar-btn { background: rgba(255,255,255,0.1); border: none; padding: 12px; color: white; font-weight: bold; text-align: left; border-radius: 10px; cursor: pointer; transition: 0.2s; font-size: 0.95rem;}
        .sidebar-btn:hover { background: var(--orange); }
        .sidebar-btn.active { background: var(--bright-yellow); color: var(--dark-blue); }
        .dash-content { flex: 1; padding: 30px; overflow-y: auto; background: var(--bg-light); }
        
        .map-grid { display: flex; flex-wrap: wrap; gap: 20px; justify-content: center; padding: 20px 0; }
        .mission-card { background: white; border: 4px solid #ddd; border-radius: 20px; width: 180px; padding: 15px; text-align: center; cursor: pointer; transition: transform 0.2s; box-shadow: 0 5px 15px rgba(0,0,0,0.1); }
        .mission-card:hover:not(.locked) { transform: scale(1.05); }
        .mission-card.locked { opacity: 0.6; cursor: not-allowed; background: #eee; }
        .mission-card.unlocked { border-color: var(--primary-blue); }
        .mission-card.completed { border-color: var(--nature-green); }

        .tabs { display: flex; justify-content: center; gap: 10px; margin-bottom: 20px; }
        .tab-btn { padding: 10px 20px; border: 2px solid var(--primary-blue); background: white; border-radius: 20px; cursor: pointer; font-weight: bold; color: var(--primary-blue); transition: 0.3s; }
        .tab-btn.active { background: var(--primary-blue); color: white; }
        .tab-content { display: none; background: white; padding: 20px; border-radius: 20px; box-shadow: 0 4px 10px rgba(0,0,0,0.05); border: 2px solid #eee;}
        .tab-content.active { display: block; animation: fadeIn 0.3s; }

        .lab-container { border: 3px solid var(--dark-blue); border-radius: 15px; padding: 20px; background: #1e272e; color: white; position: relative; min-height: 350px; margin-bottom: 20px; display: flex; flex-direction: column; align-items: center; justify-content: center;}
        
        #sertifikat-container { background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600"><rect fill="%23f1c40f" width="800" height="600"/><rect fill="%23ffffff" x="20" y="20" width="760" height="560" rx="20"/></svg>') no-repeat center center; background-size: cover; padding: 40px; border-radius: 20px; text-align: center; border: 5px solid var(--bright-yellow); color: var(--dark-blue); box-shadow: 0 10px 30px rgba(0,0,0,0.2); max-width: 800px; margin: 0 auto; position: relative;}
        
        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 100; display: none; justify-content: center; align-items: center;}
        .modal-content { background: white; padding: 30px; border-radius: 20px; text-align: center; max-width: 500px; width: 90%; box-shadow: 0 10px 30px rgba(0,0,0,0.3); border: 4px solid var(--primary-blue);}
        .modal-content input, .modal-content select { width: 100%; padding: 12px; margin-bottom: 15px; border: 2px solid #ddd; border-radius: 10px; font-size: 1.1rem; text-align: center; }

        /* NEW CSS: GALERI, BADGES, GURU, JURNAL */
        .badge-container { display: flex; gap: 15px; flex-wrap: wrap; justify-content: center; margin-top: 15px; }
        .badge-item { display: flex; flex-direction: column; align-items: center; opacity: 0.3; filter: grayscale(100%); transition: 0.3s; width: 100px; text-align: center;}
        .badge-item.earned { opacity: 1; filter: grayscale(0%); transform: scale(1.05); }
        .badge-icon { font-size: 50px; background: white; border: 3px solid var(--bright-yellow); border-radius: 50%; width: 70px; height: 70px; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(0,0,0,0.1); margin-bottom: 5px;}
        .badge-title { font-size: 0.8rem; font-weight: bold; color: var(--dark-blue); }

        .gallery-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
        .gallery-card { background: white; border-radius: 15px; overflow: hidden; box-shadow: 0 5px 15px rgba(0,0,0,0.1); border: 2px solid #eee; display:flex; flex-direction:column;}
        .gallery-img-placeholder { background: var(--sky-blue); height: 150px; display: flex; align-items: center; justify-content: center; font-size: 60px; border-bottom: 3px solid var(--primary-blue);}
        .gallery-body { padding: 15px; flex: 1; display:flex; flex-direction:column;}
        .gallery-buttons { display: flex; flex-wrap: wrap; gap: 5px; margin-top: auto; }
        .gallery-btn { flex: 1; background: var(--bg-light); border: 1px solid #ccc; border-radius: 5px; padding: 5px; cursor: pointer; font-size: 0.8rem; font-weight: bold; transition:0.2s;}
        .gallery-btn:hover { background: var(--primary-blue); color: white;}

        .table-guru { width: 100%; border-collapse: collapse; margin-top: 20px; background: white; }
        .table-guru th, .table-guru td { border: 1px solid #ddd; padding: 10px; text-align: left; }
        .table-guru th { background-color: var(--primary-blue); color: white; }
        
        @media print {
            body { background: white; padding: 0; margin: 0; display: block; }
            #app-container { box-shadow: none; border: none; max-width: 100%; height: auto; display: block;}
            .screen { display: none !important; position: static; }
            #screen-certificate { display: block !important; }
            .header-bar, .cert-buttons, #floating-profile, #mascot-container { display: none !important; }
            #sertifikat-container { border: 10px solid var(--primary-blue); width: 100%; height: 95vh; display: flex; flex-direction: column; justify-content: center; box-shadow: none;}
        }
    </style>
</head>
<body>

<div id="app-container">
    
    <!-- HEADER NAV -->
    <div class="header-bar" id="main-header" style="display: none;">
        <div class="header-title">🕵️‍♂️ Cahaya Explorer</div>
        <div class="header-stats">
            <span>⭐ <span id="ui-stars">0</span></span>
            <span>🏆 <span id="ui-score">0</span></span>
            <div class="audio-controls">
                <button class="btn-audio" id="btn-bgm" onclick="toggleBGM()">🎵 BGM: ON</button>
                <button class="btn-audio" id="btn-sfx" onclick="toggleSFX()">🔊 SFX: ON</button>
            </div>
        </div>
    </div>

    <!-- 1. WELCOME SCREEN -->
    <div id="screen-welcome" class="screen active">
        <div class="cloud" style="width: 100px; height: 30px; top: 10%; left: -150px; animation-duration: 25s;"></div>
        <div class="cloud" style="width: 150px; height: 40px; top: 30%; left: -200px; animation-duration: 35s;"></div>
        <div class="cloud" style="width: 80px; height: 25px; top: 60%; left: -100px; animation-duration: 20s;"></div>

        <!-- Profil Pengembang & Identitas Sekolah -->
        <div id="floating-profile" onclick="this.classList.toggle('expanded')" title="Klik untuk melihat Profil Pengembang">
            <div class="profile-avatar"><span class="profile-initials">CM</span><img id="home-profile-img" src="https://iili.io/nSiSkAX.md.png" alt="" onerror="this.style.display='none'"></div>
            <div class="profile-details">
                <div id="home-guru-name" style="font-weight: bold; color: var(--dark-blue); font-size: 0.95rem;">Cindrianingsih Mahajani, S.Pd</div>
                <div id="home-school-name" style="font-size: 0.8rem; color: #555;">MIN 1 Kota Gorontalo</div>
                <div style="font-size: 0.75rem; color: var(--primary-blue);">cindrianingsihm@gmail.com</div>
            </div>
            <div class="profile-school-logo"><img id="home-school-logo" src="https://iili.io/n8c9lgR.png" alt="Logo Sekolah" onerror="this.src='https://placehold.co/100x100/00b894/white?text=Logo'"></div>
        </div>

        <div class="welcome-card">
            <img id="welcome-logo" src="https://iili.io/n8c9lgR.png" alt="Logo Sekolah" style="height: 100px; margin: 0 auto 15px auto; display: block; filter: drop-shadow(0 5px 10px rgba(0,0,0,0.15));" onerror="this.src='https://placehold.co/100x100/00b894/white?text=Logo'">
            <h1 class="app-title">CAHAYA<br>EXPLORER</h1>
            <div style="font-size: 1.5rem; color: var(--orange); margin-bottom: 20px; font-weight: bold;">Misi Detektif Cahaya</div>
            <p style="margin-bottom: 20px; color: #555;">Mari berpetualang, amati alam, dan temukan rahasia sifat-sifat cahaya ciptaan Allah!</p>
            <div style="display: flex; flex-direction: column; gap: 15px; width: 70%; margin: 0 auto;">
                <button class="btn btn-primary" onclick="showInputModal()">▶ MULAI PETUALANGAN</button>
                <button class="btn" onclick="showScreen('screen-dashboard')">👤 PROFIL & DASHBOARD</button>
            </div>
        </div>
    </div>

    <!-- 2. PETA MISI -->
    <div id="screen-map" class="screen">
        <div class="dashboard-layout">
            <div class="sidebar" id="sidebar-map">
                <!-- Diisi via JS (Navigasi Global) -->
            </div>
            <div class="content-area">
                <h2>Peta Misi Petualangan</h2>
                <div class="map-grid" id="mission-container"></div>
                <div style="text-align: center; margin-top: 30px;">
                    <button class="btn btn-primary" onclick="checkAllMissionsCompleted()">Uji Pengetahuan (Kuis) ➔</button>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. MATERI, LAB & GAME -->
    <div id="screen-mission-detail" class="screen">
        <div class="content-area">
            <button class="btn" onclick="showScreen('screen-map')" style="margin-bottom: 15px; padding: 5px 15px;">⬅ Kembali Peta</button>
            <h2 id="misi-judul">Judul Misi</h2>
            
            <div class="tabs">
                <button class="tab-btn active" onclick="switchTab('materi')">📖 Ayo Mempelajari</button>
                <button class="tab-btn" onclick="switchTab('lab')">🧪 Laboratorium (Mencoba)</button>
                <button class="tab-btn" id="tab-btn-game" onclick="switchTab('game')">🕵️‍♂️ Misi Detektif</button>
            </div>

            <!-- Tab Materi -->
            <div id="tab-materi" class="tab-content active">
                <div style="text-align:center; font-size: 80px;" id="materi-icon">🔦</div>
                <p id="materi-teks" style="font-size: 1.1rem; line-height: 1.6; margin: 15px 0; font-weight:bold;"></p>
                <div style="background: #fff3cd; padding: 15px; border-left: 5px solid var(--bright-yellow); border-radius: 10px; margin-bottom: 15px;"><strong>💡 Tahukah Kamu?</strong> <span id="materi-fakta"></span></div>
                
                <div class="panel-fenomena" id="materi-fenomena">
                    <h4>🔍 Pernahkah Kamu Menemukan Ini?</h4>
                    <div id="fenomena-isi"></div>
                    <div class="aktivitas" id="fenomena-aktivitas"></div>
                </div>

                <div class="panel-islami" id="materi-ayat">
                    <h4>✨ Ayat Allah, Cahaya Kehidupan</h4>
                    <div style="font-size: 1.1rem; color: var(--bright-yellow); font-weight:bold; margin-bottom:5px;" id="quran-surah"></div>
                    <div class="arabic-text" id="quran-arab"></div>
                    <div class="ayat-terjemah" id="quran-arti"></div>
                    <div class="ayat-pesan"><strong>Pesan:</strong> <span id="quran-pesan"></span></div>
                </div>

                <div class="panel-refleksi" id="materi-refleksi">
                    <h4>💭 Renungan Hati (Refleksi)</h4>
                    <div class="panca-cinta" id="refleksi-cinta"></div>
                    <p id="refleksi-tanya"></p>
                    <textarea id="refleksi-jawaban" placeholder="Tuliskan pemikiran dan jawabanmu di sini ya..."></textarea>
                    <button class="btn btn-success" style="margin-top:10px;" onclick="simpanRenunganMisi()">Simpan Renungan</button>
                </div>

                <div style="background: #e8f4f8; padding: 15px; border-radius: 10px; margin-top: 20px;"><strong>📌 Rangkuman:</strong> <span id="materi-rangkuman"></span></div>
                
                <div style="text-align: center; margin-top: 25px;">
